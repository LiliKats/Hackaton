# Test Environment Configuration
NODE_ENV=test

# Database (will be overridden by TestContainers)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=test
DB_PASSWORD=test
DB_DATABASE=leaveboard_test

# JWT
JWT_SECRET=test-secret-key-for-testing-only
JWT_EXPIRES_IN=1h

# Redis (optional for tests)
REDIS_HOST=localhost
REDIS_PORT=6379

# Email (mock in tests)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASS=test
EMAIL_FROM=noreply@test.com
