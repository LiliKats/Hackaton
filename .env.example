# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=leaveboard
DATABASE_USER=leaveboard_user
DATABASE_PASSWORD=leaveboard_pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# SMTP (Email)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@leaveboard.local

# Application
NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_PORT=3000

# LDAP/AD (Optional)
LDAP_URL=ldap://localhost:389
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=

# API
VITE_API_URL=http://localhost:3001
