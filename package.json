{
  "name": "leaveboard",
  "version": "1.0.0",
  "description": "Vacation and absence tracking system",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "db:migrate": "npm run migration:run --workspace=backend",
    "db:seed": "npm run seed:run --workspace=backend",
    "test": "npm run test --workspaces",
    "test:backend": "npm run test --workspace=backend",
    "test:backend:watch": "npm run test:watch --workspace=backend",
    "test:backend:cov": "npm run test:cov --workspace=backend",
    "test:backend:e2e": "npm run test:e2e --workspace=backend",
    "test:frontend": "npm run test:run --workspace=frontend",
    "test:frontend:watch": "npm run test --workspace=frontend",
    "test:frontend:cov": "npm run test:coverage --workspace=frontend",
    "test:frontend:e2e": "npm run test:e2e --workspace=frontend",
    "test:e2e": "npm run test:e2e --workspaces",
    "test:coverage": "npm run test:backend:cov && npm run test:frontend:cov"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
